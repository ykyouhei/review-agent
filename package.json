{
  "name": "review-agent",
  "version": "0.1.0",
  "description": "CI-agnostic, agentic pull request review CLI with pluggable agent SDKs and VCS providers",
  "type": "module",
  "license": "MIT",
  "bin": {
    "review-agent": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@aws-sdk/client-codecommit": "^3.600.0",
    "@github/copilot-sdk": "^1.0.5",
    "commander": "^13.0.0",
    "gray-matter": "^4.0.3",
    "picomatch": "^4.0.2",
    "yaml": "^2.6.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/picomatch": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
